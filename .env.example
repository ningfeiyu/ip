# 示例文件：只含键名与格式说明，不含任何真实密钥。复制为 .env 后再填自己的值，并 chmod 600 .env。
# 运行模式：cloud=上传到云端，local=仅本地测速不上传
DEFAULT_MODE="cloud"
# 功能开关：true/false
USE_GH="true"
USE_R2="false"
USE_TG="false"
USE_MAIL="false"
# IP 来源：完整 URL，如 https://example.com/ips.txt（必填，缺失则 update.py 直接退出）
INPUT_URL="https://example.com/ips.txt"
# 下载超时（秒，可选，有默认值）
DOWNLOAD_TIMEOUT="60"
# 采样上限（条，可选）、TCP 并发（可选）、TCP 超时（秒，可选）
MAX_NODES="1000000"
TCP_WORKERS="400"
TCP_TIMEOUT="1.5"
# 测速并发（可选）、测速超时（秒，可选）、进程缓冲（秒，可选）、最低达标速度（Mbps，可选）
SPEED_WORKERS="12"
SPEED_TIMEOUT="6"
SPEED_PROCESS_BUFFER="16"
SPEED_MIN="8"
# 每个地区保留数（可选）、延迟上限（毫秒，0=不限制，可选）
TOP_PER_REGION="10"
MAX_LATENCY="0"
# 达标优选最少条数：低于该数保留旧结果并退出码 2（可选，默认 5）
MIN_BEST_COUNT="5"
# 证书校验：默认 false=校验。仅反代/ProxyIP 节点证书与 speed.cloudflare.com 不匹配时才设 true，
# 此时结果未经证书校验，不能证明是 Cloudflare 直连 IP。
SPEED_INSECURE="false"
# Cloudflare R2：变量名须与 README 和 auto.sh 一致，均用 CF_ 前缀
CF_ACCOUNT_ID="请填写"
CF_ACCESS_KEY="请填写"
CF_SECRET_KEY="请填写"
CF_BUCKET_NAME="请填写"
# GitHub 上传：api 或 push；仓库所有者、仓库名、Token（classic，需 repo 权限）
GH_SYNC_MODE="api"
GH_OWNER="请填写"
GH_REPO_NAME="请填写"
GH_TOKEN="请填写"
GH_USE_PROXY="false"
GH_PROXY_DOMAIN="请填写"
# Telegram：机器人 Token、接收 Chat ID、域名代理开关/域名
TG_BOT_TOKEN="请填写"
TG_CHAT_ID="请填写"
TG_USE_PROXY="false"
TG_PROXY_DOMAIN="请填写"
# 邮件：SMTP 服务器、发件人、授权码、收件人
MAIL_HOST="请填写"
MAIL_USER="请填写"
MAIL_PASS="请填写"
MAIL_TO="请填写"
# 本地代理：true/false、代理地址（完整 URL）
LOCAL_USE_PROXY="false"
LOCAL_PROXY_ADDR="请填写"
